{
  "name": "pkl.tmbundle",
  "version": "1.0.0",
  "description": "Pkl TextMate grammar",
  "main": "index.js",
  "scripts": {
    "build:pkl": "pkl eval -m . pkl/index.pkl",
    "clean": "rm -f Snippets/*.* && rm -f Syntaxes/*.*",
    "build": "npm run clean && npm run build:pkl",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:playground": "node scripts/build-playground.mjs",
    "playground": "bash scripts/playground.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apple/pkl.tmbundle.git"
  },
  "keywords": [
    "pkl",
    "textmate"
  ],
  "author": "The Pkl Authors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/apple/pkl.tmbundle/issues"
  },
  "homepage": "https://github.com/apple/pkl.tmbundle#readme",
  "devDependencies": {
    "@shikijs/themes": "^4.6.0",
    "esbuild": "^0.28.2",
    "live-server": "^1.2.2",
    "onchange": "^7.1.0",
    "plist": "^5.1.2",
    "shiki": "^4.6.0"
  }
}
