amends "tmLanguage.pkl"

name = "Pkl"

scopeName = "source.pkl"

uuid = "0598575b-33f4-42c1-b797-5b93a6cfc03a"

fileTypes {
  "pkl"
  "pcf"
}

foldingStartMarker = "\\{"

foldingStopMarker = "}"

local function escape(numPounds: Int): MatchPattern = new {
  name = "constant.character.escape.\(numPounds).pkl"
  local escapeChar = #"\\"# + "\\#".repeat(numPounds)
  match = #"""
    (?x:                 # turn on extended mode
      \#(escapeChar)
      (?:
        [trn"\\]         # tab, carriage return, newline, quote, backslash
        |                # OR
        u                # the letter u
        \{               # curly opening brace literal
        [\da-fA-F]+      # 1 or more hex number literal
        }                # curly end literal
      )
      |                  # OR
      (                  # capture group: invalid escape
        \#(escapeChar)   # the escape char
        .                # any character
      )
    )
    """#
  captures {
    ["1"] {
      name = "invalid.illegal.unrecognized-string-escape.pkl"
    }
  }
}

/// String interpolation, e.g. `\(foo)`. The interpolated expression is tokenized as regular Pkl code.
local function interpolation(numPounds: Int): BeginEndPattern = new {
  local escapeChar = #"\\"# + "\\#".repeat(numPounds)
  contentName = "meta.interpolation.pkl"
  begin = #"\#(escapeChar)\("#
  end = #"\)"#
  captures {
    ["0"] {
      name = "constant.character.escape.\(numPounds).pkl"
    }
  }
  patterns {
    new IncludePattern { include = "#parentheses" }
    new IncludePattern { include = "$self" }
  }
}

local function singlelineString(numPounds: Int): BeginEndPattern = new {
  name = "string.quoted.double.\(numPounds).pkl"
  local pounds = "#".repeat(numPounds)
  local stringStart = "(" + pounds + "\"" + ")"
  local stringEnd = "(" + "\"" + pounds.replaceAll("#", "\\#") + ")"
  begin = stringStart
  beginCaptures {
    ["1"] { name = "punctuation.delimiter.pkl" }
  }
  end = #"""
    (?x:
      \#(stringEnd)         # string end
      |                     # OR
      (.?$)                 # error; unterminated string (flag last character as an error)
    )
    """#
  endCaptures {
    ["1"] { name = "punctuation.delimimter.pkl" }
    ["2"] { name = "invalid.illegal.newline.pkl" }
  }
  patterns {
    interpolation(numPounds)
    escape(numPounds)
  }
}

/// A line continuation in a multiline string: an escape character that is immediately followed by a newline
/// (LF or CRLF), e.g. a `\` at the end of a line.
local function lineContinuation(numPounds: Int): MatchPattern = new {
  local escapeChar = #"\\"# + "\\#".repeat(numPounds)
  name = "constant.character.escape.\(numPounds).pkl"
  match = #"\#(escapeChar)(?=\r?$)"#
}

local function multilineString(numPounds: Int): BeginEndPattern = new {
  local pounds = "#".repeat(numPounds)
  name = "string.quoted.triple.\(numPounds).pkl"
  begin = #"""
    (\#(pounds)""")
    """#
  end = #"""
    ("""\#(pounds))
    """#
  captures {
    ["1"] {
      name = "punctuation.delimiter.pkl"
    }
  }
  patterns {
    lineContinuation(numPounds)
    interpolation(numPounds)
    escape(numPounds)
  }
}

/// Matches an identifier, plain (`foo`) or quoted (`` `foo-bar` ``).
@SourceCode { language = "RegExp" }
local identRegex: String = #"(?:[\p{L}_$][\p{L}0-9_$]*|`[^`]+`)"#

/// An identifier, plain (`foo`) or quoted (`` `foo-bar` ``).
local identifier: MatchPattern = new {
  name = "variable.other.property.pkl"
  match = identRegex
}

/// Matches the position at which a type that is not delimited by brackets (e.g. `Int`, `String?`,
/// `String | Int`) is complete.
///
/// This is the case right after a token that can end a type, when what follows
/// is not the continuation of a type (a union `|`, type arguments `<`, a constraint `(`,
/// the arrow of a function type `->`, or the nullable marker `?` of a parenthesized type).
@SourceCode { language = "RegExp" }
local typeEnd: String = #"(?<=[\p{L}0-9_$>?)"`])(?<!->)(?=\s*(?:[^\s|<(\-?]|\?\?|-(?!>)|$))"#

local languageConstant: Pattern = new KeywordMatchPattern {
  name = "constant.character.language.pkl"
  // language=regexp
  keywords {
    "true"
    "false"
    "null"
  }
}.pattern

local lineComment: MatchPattern = new {
  name = "comment.line.pkl"
  match = "//.*"
}

local blockComment: BeginEndPattern = new {
  name = "comment.block.pkl"
  // language=regexp
  begin = "/\\*"
  // language=regexp
  end = "\\*/"
}

local modifier: Pattern = new KeywordMatchPattern {
  name = "storage.modifier.pkl"
  keywords {
    "hidden"
    "local"
    "abstract"
    "external"
    "open"
    "in"
    "out"
    "amends"
    "extends"
    "fixed"
    "const"
  }
}.pattern

local controlKeyword: Pattern = new KeywordMatchPattern {
  name = "keyword.control.pkl"
  keywords {
    "if"
    "else"
    "when"
    "for"
    "import"
    "new"
  }
}.pattern

local class KeywordMatchPattern {
  local self = this
  name: String
  keywords: Listing<String>(isDistinct)

  pattern: MatchPattern = new {
    name = self.name
    match = new Listing {
      "\\b"
      "("
      // sort keywords by length; otherwise the first alternative match wins (e.g. `read` wins over `read?`).
      keywords.toList().sortBy((keyword) -> -keyword.length).join("|")
      ")"
      // not `\\b`, because keywords like `read?` end in a non-word character
      "(?!\\w)"
    }.join("")
  }
}

local symbolOperator: MatchPattern = new {
  name = "keyword.operator.pkl"
  match = #"""
    (?x:
      # MATH
      \+    # add
      |
      -     # minus
      |
      \*    # multiply
      |
      /     # divide
      |
      ~/    # integer divide
      |
      %     # modulo
      |
      \*\*  # power
      |
      >     # greater than
      |
      >=    # greater than or equals
      |
      <     # less than
      |
      <=    # less than or equals
      |
      ==    # equals
      |
      !=    # not equals

      # LOGICAL
      |
      !     # unary not
      |
      &&    # and
      |
      \|\|  # or
      |

      # MISCELLANEOUS
      \|>   # function pipe
      |
      \?\?  # nullish coalesce
      |
      !!    # non-null assertion
      |
      =     # assignments
      |
      ->    # lambda arrow
      |
      \|    # type union
    )
    """#
}

local punctuation: MatchPattern = new {
  name = "punctuation.pkl"
  match = #"""
    (?x:
      \?\.  # optional chain
      |
      \.    # member access
      |
      ;     # semicolon
      |
      :     # colon
    )
    """#
}

local keywordOperator: MatchPattern = new KeywordMatchPattern {
  name = "keyword.pkl"
  keywords {
    "amends"
    "as"
    "extends"
    "function"
    "is"
    "let"
    "read"
    #"read\*"#
    #"read\?"#
    "import"
    #"import\*"#
    "throw"
    "trace"
  }
}.pattern


local builtInVariable: Pattern = new KeywordMatchPattern {
  name = "variable.language.pkl"
  // language=regexp
  keywords {
    "this"
    "module"
    "outer"
    "super"
  }
}.pattern

local builtInTypes: Pattern = new KeywordMatchPattern {
  name = "support.type.pkl"
  keywords {
    "unknown"
    "never"
  }
}.pattern

local braces: MatchPattern = new {
  name = "meta.brace.pkl"
  match = #"[(){}\[\]]"#
}

local hexLiteral: MatchPattern = new {
  name = "constant.numeric.hex.pkl"
  match = #"""
    (?x:
      \b
      0x(?:[\da-fA-F][\da-fA-F_]*[\da-fA-F]|[\da-fA-F_])
      \b
    )
    """#
}

local binaryLiteral: MatchPattern = new {
  name = "constant.numeric.binary.pkl"
  match = #"""
    (?x:
      \b
      0b(?:[0-1][0-1_]*[0-1]|[0-1])
      \b
    )
    """#
}

local octalLiteral: MatchPattern = new {
  name = "constant.numeric.octal.pkl"
  match = #"""
    (?x:
      \b
      0o(?:[0-7][0-7_]*[0-7]|[0-7])
      \b
    )
    """#
}

local decimalLiteral: MatchPattern = new {
  name = "constant.numeric.decimal.pkl"
  match = #"""
    (?x:
      \b
      (?:\d[0-9_]*\d|\d)
      \b
    )
    """#
}

local floatLiteral: MatchPattern = new {
  name = "constant.numeric.pkl"
  match = #"""
    (?x:
      \b
      (?:
        (?:\d[0-9_]*\d|\d)?              # 0 or more digits
        \.                               # dot literal
        (?:\d[0-9_]*\d|\d)               # 1 or more digits
        (?:[eE][+-]?(?:\d[0-9_]*\d|\d))? # optional exponent
        |                                # OR
        (?:\d[0-9_]*\d|\d)               # 1 or more digits
        [eE][+-]?(?:\d[0-9_]*\d|\d)      # exponent
      )
      \b
    )
    """#
}

local classKeyword: Pattern = new KeywordMatchPattern {
  name = "keyword.class.pkl"
  keywords {
    "class"
    "typealias"
  }
}.pattern

local annotation: MatchPattern = new {
  name = "entity.name.type.pkl"
  match = #"@\#(identRegex)"#
}

local modulePattern: MatchPattern = new {
  match = #"""
    (?x:
      \b
      (module)
      \s+
      (
        \#(identRegex)(?:\.\#(identRegex))*
      )
    )
    """#
  captures {
    ["1"] {
      name = "variable.language.pkl"
    }
    ["2"] {
      name = "variable.other.module.pkl"
    }
  }
}

/// Patterns for a type parameter list, e.g. `<in T, out U>` in `class Foo<in T, out U>`.
local typeParameterPatterns: Listing<Pattern> = new {
  new MatchPattern {
    name = "storage.modifier.pkl"
    match = #"\b(?:in|out)(?=\s+\#(identRegex))"#
  }
  new MatchPattern {
    name = "entity.name.type.pkl"
    match = #"\#(identRegex)|[<>]"#
  }
}

local typeAlias: BeginEndPattern = new {
  begin = #"""
    (?x:
      (typealias)
      \s+
      (\#(identRegex))
      \s*(<[^>]*>)? # type parameters
      \s*(=)\s*
    )
    """#
  beginCaptures {
    ["1"] {
      name = "keyword.class.pkl"
    }
    ["2"] {
      name = "entity.name.type.pkl"
    }
    ["3"] {
      patterns = typeParameterPatterns
    }
    ["4"] {
      name = "keyword.operator.pkl"
    }
  }
  end = #"\#(typeEnd)|^[ \t]*$"#
  patterns = typeReference
}

local variableDecl: MatchPattern = new {
  match = #"""
    (?x:
      (?<![\p{L}0-9_$])
      (\#(identRegex)) # variable name
      \s*
      (=)(?!=)
    )
    """#
  captures {
    ["1"] {
      name = "variable.other.property.pkl"
    }
    ["2"] {
      name = "keyword.operator.pkl"
    }
  }
}

local variableDeclType: BeginEndPattern = new {
  begin = #"""
    (?x:
      ((?:\b|\s*)\#(identRegex)) # variable name
      \s*
      (:)
      \s*
      (?=[\p{L}_$"`(]) # start of a type
    )
    """#
  beginCaptures {
    ["1"] {
      name = "variable.other.property.pkl"
    }
    ["2"] {
      name = "punctuation.pkl"
    }
  }
  end = #"\s*(=)|,|\)|\#(typeEnd)|^[ \t]*$"#
  endCaptures {
    ["1"] {
      name = "keyword.operator.pkl"
    }
  }
  patterns = typeReference
}

/// A type annotation that is not preceded by a variable name, for example a function return type.
local typeAnnotation: BeginEndPattern = new {
  begin = #"(:)\s*(?=[\p{L}_$"`(])"#
  beginCaptures {
    ["1"] {
      name = "punctuation.pkl"
    }
  }
  end = #"\#(typeEnd)|^[ \t]*$"#
  patterns = typeReference
}

/// A type with type arguments, e.g. `Mapping<String, Listing<Int>>`.
///
/// The type name and opening bracket are the begin match, and the closing bracket is the end match.
/// The type arguments are tokenized by [typePatterns] (via `#type`), which includes this pattern recursively.
local genericType: BeginEndPattern = new {
  begin = #"\#(identRegex)\s*<"#
  // Also end at a blank line, `{`, `}` or `=` so that a stray `<` does not swallow the rest of the file.
  end = #">\??|(?=[{}=])|^[ \t]*$"#
  captures {
    ["0"] {
      name = "entity.name.type.pkl"
    }
  }
  patterns = typeReference
}

local typeName: MatchPattern = new {
  name = "entity.name.type.pkl"
  match = #"\#(identRegex)\??"#
}

/// Parenthesized code, e.g. a constraint following a type (`String(length > 3)`)
/// or a parenthesized expression within a string interpolation.
///
/// Its contents are regular Pkl code, and can contain nested parentheses.
local parentheses: BeginEndPattern = new {
  begin = #"\("#
  end = #"\)"#
  captures {
    ["0"] {
      name = "meta.brace.pkl"
    }
  }
  patterns {
    new IncludePattern { include = "#parentheses" }
    new IncludePattern { include = "$self" }
  }
}

/// The union operator within a type, e.g. `Foo | Bar`.
local typeUnion: MatchPattern = new {
  name = "keyword.operator.pkl"
  match = #"\|"#
}

/// Patterns that make up a type.
local typePatterns: Listing<Pattern> = new {
  lineComment
  blockComment
  typeUnion
  new IncludePattern { include = "#generic-type" }
  typeName
  typeConstraint
  typeParentheses
  typeArrow
  typeNullable
  new IncludePattern { include = "#strings" }
}

/// A constraint following a type, e.g. `(length > 3)` in `String(length > 3)`.
///
/// Unlike [typeParentheses], the opening parenthesis directly follows the type.
local typeConstraint: BeginEndPattern = new {
  begin = #"(?<=[\p{L}0-9_$>?`)])\("#
  end = #"\)"#
  captures {
    ["0"] {
      name = "meta.brace.pkl"
    }
  }
  patterns {
    new IncludePattern { include = "#parentheses" }
    new IncludePattern { include = "$self" }
  }
}

/// Parenthesized types: the parameters of a function type, e.g. `(Int, String)` in `(Int, String) -> Boolean`,
/// or a grouped type, e.g. `(Foo | Bar)?`.
local typeParentheses: BeginEndPattern = new {
  begin = #"\("#
  end = #"\)"#
  captures {
    ["0"] {
      name = "meta.brace.pkl"
    }
  }
  patterns = typeReference
}

/// The arrow of a function type, e.g. `->` in `(Int) -> String`.
local typeArrow: MatchPattern = new {
  name = "keyword.operator.pkl"
  match = #"->"#
}

/// The nullable marker of a parenthesized type, e.g. `?` in `((Int) -> String)?`.
local typeNullable: MatchPattern = new {
  name = "entity.name.type.pkl"
  match = #"\?(?!\?)"#
}

/// Reference to the `type` repository entry.
local typeReference: Listing<Pattern> = new {
  new IncludePattern { include = "#type" }
}

/// All string literals.
local stringPatterns: Listing<Pattern> = new {
  for (numPounds in IntSeq(0, 6)) {
    multilineString(numPounds)
    singlelineString(numPounds)
  }
}

/// A method call, e.g. `foo()`, `foo<Int>()` or `qux.foo()`.
///
/// The whole call is scoped as `meta.function-call.pkl`, including the receiver, type arguments, parentheses and arguments.
///
/// To tell a generic call apart from a comparison like `a < b`, the opening bracket must be followed by something
/// that looks like type arguments, and a closing bracket that is directly followed by `(`.
local functionCall: BeginEndPattern = new {
  name = "meta.function-call.pkl"
  begin = #"""
    (?x:
      ((?:\#(identRegex)\s*(?:\?\.|\.)\s*)*) # receiver, e.g. `qux.`
      (?!(?:if|else|when|for|let|in|is|as|throw|trace|read|import|new|function)(?![\p{L}0-9_$])) # keywords that look like calls
      (\#(identRegex)) # method name
      (?=\s*(?:<(?:[\p{L}0-9_$,\s<>?|.]|"[^"]*"|`[^`]+`)*>\s*)?\() # type arguments, followed by call arguments
    )
    """#
  beginCaptures {
    ["1"] {
      patterns {
        new IncludePattern { include = "$self" }
      }
    }
    ["2"] {
      name = "variable.function.pkl"
    }
  }
  // The call is complete after its arguments.
  end = #"(?<=\))"#
  patterns {
    callTypeArguments
    new IncludePattern { include = "#parentheses" }
  }
}

/// Type arguments of a method call, e.g. `<Int>` in `foo<Int>()`.
local callTypeArguments: BeginEndPattern = new {
  begin = #"<"#
  // Also end at a blank line, `{`, `}` or `=` so that a stray `<` does not swallow the rest of the file.
  end = #">|(?=[{}=])|^[ \t]*$"#
  captures {
    ["0"] {
      name = "entity.name.type.pkl"
    }
  }
  patterns = typeReference
}

local forPattern: MatchPattern = new {
  match = #"""
    (?x:
      \b(for)
      \s*\(
      (\#(identRegex))(?:\s*,\s*(\#(identRegex)))* # bindings
      \s+
      (in)
    )
    """#
  captures {
    ["1"] {
      name = "keyword.control.pkl"
    }
    ["2"] {
      name = "variable.other.property.pkl"
    }
    ["3"] {
      name = "variable.other.property.pkl"
    }
    ["4"] {
      name = "storage.modifier.pkl"
    }
  }
}

local clazz: MatchPattern = new {
  match = #"\b(class)\s+(\#(identRegex))\s*(<[^>]*>)?"#
  captures {
    ["1"] {
      name = "keyword.class.pkl"
    }
    ["2"] {
      name = "entity.name.type.pkl"
    }
    ["3"] {
      patterns = typeParameterPatterns
    }
  }
}

local newPattern: BeginEndPattern = new {
  begin = #"\b(new)\s+(?=\#(identRegex))"#
  beginCaptures {
    ["1"] {
      name = "keyword.control.pkl"
    }
  }
  end = #"\#(typeEnd)|^[ \t]*$"#
  patterns = typeReference
}

local functionPattern: MatchPattern = new {
  match = #"""
    \b(function)\s+(\#(identRegex))\s*(<[^>]*>)?
    """#
  captures {
    ["1"] {
      name = "keyword.pkl"
    }
    ["2"] {
      name = "variable.function.pkl"
    }
    ["3"] {
      patterns = typeParameterPatterns
    }
  }
}

local typeTestPattern: BeginEndPattern = new {
  begin = #"\b(as|is)\s+(?=\#(identRegex))"#
  beginCaptures {
    ["1"] {
      name = "keyword.pkl"
    }
  }
  end = #"\#(typeEnd)|^[ \t]*$"#
  patterns = typeReference
}

/// The supertype of a class, e.g. `extends Bar`.
///
/// A module's `extends "foo.pkl"` is not matched, because it is followed by a string.
local extendsPattern: BeginEndPattern = new {
  begin = #"\b(extends)\s+(?=\#(identRegex))"#
  beginCaptures {
    ["1"] {
      name = "storage.modifier.pkl"
    }
  }
  end = #"\#(typeEnd)|^[ \t]*$"#
  patterns = typeReference
}

local amendedVar: MatchPattern = new {
  match = #"^\s*(\#(identRegex))\s*\{"#
  captures {
    ["1"] {
      name = "variable.other.property.pkl"
    }
  }
}

patterns {
  modulePattern
  typeAlias
  clazz
  forPattern
  newPattern
  functionPattern
  typeTestPattern
  extendsPattern
  languageConstant
  lineComment
  blockComment
  variableDeclType
  variableDecl
  typeAnnotation
  functionCall
  amendedVar
  modifier
  keywordOperator
  controlKeyword
  hexLiteral
  binaryLiteral
  octalLiteral
  decimalLiteral
  floatLiteral
  symbolOperator
  builtInVariable
  builtInTypes
  braces
  classKeyword
  punctuation
  annotation
  new IncludePattern { include = "#strings" }
  // Must come last, so that keywords, literals, etc. take precedence.
  identifier
}

repository {
  ["strings"] = new PatternList { patterns = stringPatterns }
  ["type"] = new PatternList { patterns = typePatterns }
  ["generic-type"] = genericType
  ["parentheses"] = parentheses
}
