import "pkl.tmLanguage.pkl"

import "pkl.tmLanguage.pkl"

output {
  files {
    local plistRenderer = new PListRenderer {}
    local jsonRenderer = new JsonRenderer {}
    ["syntaxes/pkl.tmLanguage"] {
      value = `pkl.tmLanguage`
      renderer = plistRenderer
    }
    ["syntaxes/pkl.tmLanguage.json"] {
      value = `pkl.tmLanguage`
      renderer = jsonRenderer
    }
    for (name, snippet in import("snippets.pkl").snippets) {
      ["Snippets/\(name).tmSnippet"] {
        value = snippet
        renderer = plistRenderer
      }
    }
  }
}
